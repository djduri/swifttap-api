{
  "DatabaseSettings": {
    "ConnectionString": "",
    "AutoMigrate": false
  },
  "CorsSettings": {
    "Origins": [],
    "Methods": [ "GET", "POST", "DELETE", "PUT", "PATCH", "OPTIONS" ],
    "Headers": [],
    "AllowCredentials": true,
    "AllowWildcardOrigins": false
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Enrichers.Environment" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/swifttap/swifttap-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} ({MachineName}) [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AuthenticationSettings": {
    "IsDevelopment": true,
    "JwtSecret": "",
    "RefreshTokenExpirationDays": 30,
    "TokenExpirationMinutes": 43200,
    "TwoFactorCodeExpirationMinutes": 10,
    "Issuer": [],
    "Audience": []
  },
  "DataSeederSettings": {
    "AdminUser": {
      "Email": "",
      "Password": "",
      "EmailConfirmed": true,
      "PhoneNumberConfirmed": true
    }
  },
  "BrandingSettings": {
    "LogoName": "SWIFTTAP Logo",
    "LogoBase64": "",
    "LogoWidthInPixels": 229,
    "LogoHeightInPixels": 161,
    "BackgroundColorHex": "#FFD800",
    "BackgroundTextColorHex": "#e6f4fd",
    "TextColorHex": "#02223b"
  },
  "EmailTemplatesSettings": {
    "Path": "/app/Templates",
    "Templates": {
      "AuthTwoFactor": "AuthTwoFactor.mustache",
      "CreateAdmin": "CreateAdmin.mustache",
      "ResetPassword": "ResetPassword.mustache",
      "ResetPasswordAsAdmin": "ResetPasswordAsAdmin.mustache",
      "CreateUser": "CreateUser.mustache",
      "RegisterUser": "RegisterUser.mustache"
    }
  },
  "MailSenderSettings": {
    "Address": "",
    "Name": "SwiftTap",
    "Username": "",
    "Password": "",
    "SmtpPort": 465,
    "SmtpHost": "smtp.gmail.com",
    "UseSslForConnection": false
  },
  "FrontendUrlSettings": {   
    "Url": "https://localhost:44375",
    "ResetPassword": "/auth/forgot-password/{userEmail}/{token}",
    //"GetUserCard": "/card/{uniqueName}",
    "GetUserCard": "/api/cms/Card/UniqueName?UniqueName={uniqueName}"
  },
  "ApiUrlSettings": {
    "Url": "https://localhost:44375",
    "NfcLink": "/api/cms/Card/{guid}"
  },
  "BackgroundJobsSettings": {
    "IsEnabled": true,
    "ConnectionString": "",
    "IsDashboardEnabled": true,
    "CronJobSchedules": {
      "RefreshTokenExpiredCleanupSchedule": "0 3 * * 1/2"
    }
  },
  "AllowedHosts": "*"
}