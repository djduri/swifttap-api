<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width,initial-scale=1" />
	<meta name="x-apple-disable-message-reformatting" />
	<title>Confirm your identity - two-step login code</title>
	<style>

		table, td, div, h1, p {
			font-family: Gill Sans, sans-serif;
		}
	</style>
</head>
<body style="margin:0;padding:0;">
	<table role="presentation" style="width: 100%; border-collapse: collapse; text-align: center;">
		<tr>
			<td align="center" style="padding:40px 0 10px 0;background:#fff;">
				<!--<img src="data:image/png;base64,{{LogoBase64}}"
							 alt="{{LogoName}}" width="{{LogoWidth}}" height="{{LogoHeight}}" style="display:block;" />-->
				<img src="{{LogoBase64}}"
					 alt="{{LogoName}}" width="{{LogoWidth}}" height="{{LogoHeight}}" style="display:block;" />
			</td>
		</tr>
		<tr>
			<td align="left" style="padding: 10px 30px 0 30px; font-size: 20px; color: {{TextColor}}; ">
				<p>Hello {{FirstName}}</p>
				<p>Thank you for using two-step login in our application. Please use the verification code below to confirm your identity:</p>
				<p></p>
			</td>
		</tr>
		<tr>
			<td align="center" style="padding: 10px 30px 10px 30px; ">
				<h1 style="background: {{BackgroundColor}}; border: solid 1px {{BackgroundColor}}; color: {{BackgroundTextColor}}; padding: 16px 32px 16px 32px; text-decoration: none; font-size: 24px; ">
					{{LoginTwoFactorCode}}
				</h1>
			</td>
		</tr>
		<tr>
			<td align="left" style="padding: 10px 30px 0 30px; font-size: 20px; color: {{TextColor}}; ">
				<p>This code is valid for {{CodeValidityLengthInMinutes}} minutes.</p>
				<p>If you have not tried to log in, please change your password immediately and contact us.</p>
			</td>
		</tr>
	</table>
</body>
</html>
